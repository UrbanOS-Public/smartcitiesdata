#!/bin/sh

# Configure release to use long names (supports FQDNs) instead of short names
# This is required for Kubernetes deployments where pods have FQDN hostnames

# FORCE distribution mode to use long names (override Kubernetes env vars)
# This must be set AFTER sourcing the environment to override K8s settings
export RELEASE_DISTRIBUTION=name

# Construct the full FQDN for the node name
# In Kubernetes, the FQDN pattern is: <pod-ip-with-dashes>.<namespace>.pod.cluster.local
# But we'll use the pod name FQDN: <hostname>.<namespace>.svc.cluster.local
if [ -n "$POD_IP" ] && [ -n "$POD_NAMESPACE" ]; then
  # Convert IP to dashed format (e.g., 11.103.45.12 -> 11-103-45-12)
  DASHED_IP=$(echo "$POD_IP" | tr '.' '-')
  FQDN="${DASHED_IP}.${POD_NAMESPACE}.pod.cluster.local"
  export RELEASE_NODE="<%= @release.name %>@${FQDN}"
  echo "Using FQDN node name: ${RELEASE_NODE}"
elif [ -n "$HOSTNAME" ]; then
  # Fallback to short hostname if POD_IP/POD_NAMESPACE not available
  export RELEASE_NODE="<%= @release.name %>@${HOSTNAME}"
  echo "Using short node name: ${RELEASE_NODE}"
else
  # Last resort fallback
  HOSTNAME=$(hostname)
  export RELEASE_NODE="<%= @release.name %>@${HOSTNAME}"
  echo "Using hostname-based node name: ${RELEASE_NODE}"
fi
